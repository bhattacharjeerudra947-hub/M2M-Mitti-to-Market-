# ═══════════════════════════════════════════════════════════════════
# Mitti2Market Backend — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `backend/.env` on each teammate's computer.
# DO NOT commit real credentials or secrets to Git.
# ═══════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Shared Central MySQL Database ──────────────────────────
# Option 1: Shared Cloud MySQL (Aiven, Clever Cloud, AWS RDS, etc.)
# Replace with the shared team database host, port, db name, and user:
# DB_URL=jdbc:mysql://<SHARED_HOST>:<PORT>/mitti2market?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&autoReconnect=true
# DB_USERNAME=<SHARED_USER>
# DB_PASSWORD=<SHARED_PASSWORD>

# Option 2: Local MySQL (standalone fallback)
DB_URL=jdbc:mysql://localhost:3306/mitti2market?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_local_password

# ─── Connection Pool (HikariCP) ──────────────────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# ─── CORS (Allowed Frontend Origins) ─────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ─── File Storage ───────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_ROOT=storage
UPLOAD_DIR=uploads/produce
UPLOAD_MAX_SIZE=5242880

# ─── Cloudinary (Images & Documents) ────────────────────────
CLOUDINARY_CLOUD_NAME=ywag4fkr
CLOUDINARY_API_KEY=255255562327416
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ─── Mandi Price API ────────────────────────────────────────
MANDI_API_KEY=your_mandi_api_key

# ─── AI (Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=m2m_jwt_super_secure_secret_key_change_me_in_production_1234567890
JWT_ACCESS_TOKEN_TTL=86400000
JWT_REFRESH_TOKEN_TTL=604800000
