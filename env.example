# ═══════════════════════════════════════════════════════════════
# Mitti2Market — Master Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
# Copy the relevant sections to:
#   backend/.env   → for Spring Boot backend
#   frontend/.env  → for React frontend (Vite)
#
# NEVER commit .env files to Git!
# ═══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
# BACKEND (.env in /backend)
# ─────────────────────────────────────────────────────────────

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/mitti2market?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
SERVER_PORT=8080

# Firebase Admin SDK
# Download from: Firebase Console → Project Settings → Service accounts
# Save as: backend/firebase-service-account.json
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# CORS (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# File Storage
STORAGE_TYPE=local              # 'local' for dev, 's3' for production
STORAGE_ROOT=storage            # local storage directory
# STORAGE_ENDPOINT=https://s3.amazonaws.com  # S3 endpoint (for 's3' type)
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_BUCKET=your-bucket-name
# STORAGE_REGION=us-east-1

# Legacy file upload
UPLOAD_DIR=uploads/produce
UPLOAD_MAX_SIZE=5242880


# ─────────────────────────────────────────────────────────────
# FRONTEND (.env in /frontend)
# ─────────────────────────────────────────────────────────────

# Backend API URL
VITE_API_BASE_URL=http://localhost:8080/api

# Firebase Client Config
# Get from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000


# ═══════════════════════════════════════════════════════════════
# HOW TO SETUP
# ═══════════════════════════════════════════════════════════════
#
# 1. MySQL:
#    - Install MySQL 8+
#    - Create database: CREATE DATABASE mitti2market;
#    - Set DB_USERNAME and DB_PASSWORD above
#
# 2. Backend:
#    - Copy this file:  cp env.example backend/.env
#    - Fill in DB_PASSWORD
#    - Run:  cd backend && mvn spring-boot:run
#
# 3. Frontend:
#    - Copy this file:  cp env.example frontend/.env
#    - Keep only VITE_* variables
#    - Run:  cd frontend && npm run dev
#
# 4. Firebase (optional — for Google/Phone login):
#    - Create project at https://console.firebase.google.com
#    - Enable Google + Phone in Authentication → Sign-in method
#    - Add web app, copy config to frontend/.env
#    - Download service account JSON to backend/
#    - Set FIREBASE_ENABLED=true in backend/.env
#
# ═══════════════════════════════════════════════════════════════
