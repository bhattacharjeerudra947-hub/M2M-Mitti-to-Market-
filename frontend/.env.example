# ═══════════════════════════════════════════════════════════════════
# Mitti2Market Frontend — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `frontend/.env` if you need to override defaults.
# By default, frontend connects to http://localhost:8080.
# ═══════════════════════════════════════════════════════════════════

# Backend API endpoint:
# If you run your local Spring Boot backend (connecting to the shared cloud MySQL):
VITE_API_URL=http://localhost:8080

# If the team hosts a single shared Spring Boot backend:
# VITE_API_URL=https://your-shared-backend.onrender.com
